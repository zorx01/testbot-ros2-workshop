<?xml version="1.0"?>
<!--
  Top-level entry point for the testbot description.

    xacro urdf/testbot.urdf.xacro                  -> mock hardware
    xacro urdf/testbot.urdf.xacro use_sim:=true    -> Gazebo hardware + sensors

  Generated by fusion2URDF v3.1.1; the use_sim argument and the three
  extra includes below are MANUAL EDITS (not from fusion2URDF).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="testbot">

  <!-- MANUAL EDIT (not from fusion2URDF) ==============================
       use_sim selects the ros2_control hardware plugin and decides
       whether the Gazebo plugin and sensor blocks are emitted at all.
       Keeping it false by default means `xacro testbot.urdf.xacro` still
       produces a plain, Gazebo-free URDF for RViz and check_urdf.
       ================================================================ -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="prefix"  default=""/>
  <!-- use_control is set by rsp.launch.py: true once the controller files
       (urdf/testbot.ros2_control.xacro + config/ros2_controllers.yaml)
       have been added to the package. -->
  <xacro:arg name="use_control" default="false"/>
  <xacro:property name="use_sim" value="$(arg use_sim)"/>
  <xacro:property name="prefix"  value="$(arg prefix)"/>

  <!-- Materials (shared across all assemblies) -->
  <material name="ABS_Plastic">
    <color rgba="0.965 0.965 0.953 1.0"/>
  </material>
  <material name="Rubber_Black">
    <color rgba="0.153 0.153 0.153 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find testbot_description)/urdf/assemblies/testbot.urdf.xacro"/>

  <!-- MANUAL EDIT (not from fusion2URDF): sim-only additions -->
  <xacro:if value="$(arg use_control)">
    <xacro:include filename="$(find testbot_description)/urdf/testbot.ros2_control.xacro"/>
  </xacro:if>
  <xacro:include filename="$(find testbot_description)/urdf/testbot.gazebo.xacro"/>
  <xacro:include filename="$(find testbot_description)/urdf/testbot.sensors.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:testbot prefix="${prefix}"/>

  <!-- MANUAL EDIT (not from fusion2URDF) ==============================
       ros2_control is always emitted (mock or Gazebo), but the Gazebo
       plugin block and the sensors only make sense under simulation.
       ================================================================ -->
  <xacro:if value="$(arg use_control)">
    <xacro:testbot_ros2_control prefix="${prefix}" use_sim="${use_sim}"/>
  </xacro:if>

  <xacro:if value="${use_sim}">
    <xacro:testbot_gazebo  prefix="${prefix}"/>
    <xacro:testbot_sensors prefix="${prefix}"/>
  </xacro:if>

</robot>
