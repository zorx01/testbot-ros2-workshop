<?xml version="1.0"?>
<!--
  testbot assembly macro.

  Generated by the Fusion 360 fusion2URDF exporter v3.1.1, then edited by hand.
  Every hand edit is tagged with  <!-\- MANUAL EDIT (not from fusion2URDF) -\->
  so it can be found again after a re-export.

  WARNING: `python tools/reframe.py <this package>` rewrites this file from
  the exporter's frame cache and will DESTROY every manual edit below.
  Re-apply them from git history if you ever regenerate.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="testbot_macro">

  <xacro:macro name="testbot" params="prefix">

    <!-- ================================================================
         Geometry constants, measured from the exported DAE meshes.
         Verified with trimesh / raw COLLADA vertex parse:
           wheel mesh bbox     0.069972 x 0.018200 x 0.069972 m
           wheel radius        0.034986 m  -> 0.035 nominal
           wheel width         0.018200 m
           wheel centres       y = +/-0.138100 m  -> separation 0.2762 m
           wheel centre height z = +0.015500 m -> wheel bottom z = -0.019500 m
           chassis bbox        0.260 x 0.260 x 0.079 m (z -0.023 .. +0.056)
           caster (merged)     sphere r=0.0050 at (0.090, 0, -0.018),
                               bottom z = -0.023 m
         ================================================================ -->
    <xacro:property name="wheel_radius" value="0.035"/>
    <xacro:property name="wheel_width"  value="0.0182"/>
    <!-- Wheel mesh runs 0 .. wheel_width along the link's +z (the joint axis),
         so the collision cylinder is centred half a width along +z. -->
    <xacro:property name="wheel_collision_z" value="0.0091"/>
    <!-- Wheel bottom in base_link: 0.0155 - 0.035 -->
    <xacro:property name="wheel_bottom_z" value="-0.0195"/>
    <xacro:property name="caster_radius"  value="0.005"/>
    <xacro:property name="caster_x"       value="0.09"/>

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.006374 -0.000113 0.026555" rpy="0 0 0"/>
        <mass value="0.480795"/>
        <inertia ixx="3.173460e-03" ixy="3.454263e-07" ixz="-2.969094e-05"
                 iyy="2.788824e-03" iyz="5.819429e-09" izz="5.353183e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://testbot_description/meshes/testbot/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="ABS_Plastic"/>
      </visual>

      <!-- MANUAL EDIT (not from fusion2URDF) ==========================
           NOTE ON COLLISION NAMES, which cost an afternoon.

           None of the <collision> elements below carry a name attribute,
           and that is deliberate. Gazebo's URDF-to-SDF converter matches
           a <gazebo reference="L"> friction block to a collision named
           exactly L_collision. Name a collision anything else and the
           mu/kp/kd values are dropped on the floor, with no warning, and
           the surface silently falls back to the ODE default of mu = 1.

           With the collisions named chassis_collision and
           caster_collision, the mu1 = mu2 = 0 meant for the caster never
           arrived. The caster then gripped the floor as hard as the
           tyres did, and the wheels stalled at 1.765 rad/s against a
           4.286 rad/s command - which reads exactly like a controller or
           a torque-limit fault and is neither. Check it with
               gz sdf -p robot.urdf
           and look for <surface> on each <collision>.

           Leaving the name off makes the converter emit base_link_collision
           and base_link_collision_1, both of which it then recognises, so
           BOTH get the friction block. Verified with gz sdf -p.
           ============================================================== -->

      <!-- MANUAL EDIT (not from fusion2URDF) ==========================
           Was: collision reused the base_link.dae visual mesh.
           A concave triangle soup is slow and unreliable in ODE, so the
           chassis is replaced by its bounding box and the merged caster
           by an explicit sphere.

           The chassis plates span x,y = +/-0.13 and z = 0 .. 0.056.
           The box is therefore a true bounding volume; the four corners
           of the real plate are chamfered (corner vertices sit at
           (+/-0.13, +/-0.09)), so the box is very slightly conservative.
           ============================================================ -->
      <collision>
        <origin xyz="0 0 0.028" rpy="0 0 0"/>
        <geometry>
          <box size="0.26 0.26 0.056"/>
        </geometry>
      </collision>

      <!-- MANUAL EDIT (not from fusion2URDF) ==========================
           CAD-vs-sim adjustment, deliberate mismatch with the mesh:

           In the CAD the caster sphere sits at z = -0.018 with its bottom
           at z = -0.023, which is 3.5 mm BELOW the wheel bottom
           (z = -0.0195). Modelled faithfully, the robot would rest on the
           caster with its nose pitched UP by 1.5 degrees (measured from
           /gazebo/model_states: -1.50 against -0.33 with the raised
           caster), the caster propping the front and the drive wheels
           sharing less of the load.

           The collision sphere is therefore raised 3.5 mm, to centre
           z = -0.0145, putting its bottom exactly level with the wheels
           at z = -0.0195. The VISUAL mesh is untouched, so the render
           still shows the true CAD.
           ============================================================ -->
      <collision>
        <origin xyz="${caster_x} 0 ${wheel_bottom_z + caster_radius}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}backward_left_wheel">
      <inertial>
        <origin xyz="-0.000000 0.000000 0.010783" rpy="0 0 0"/>
        <mass value="0.033729"/>
        <inertia ixx="1.081155e-05" ixy="-1.107598e-09" ixz="0.000000e+00"
                 iyy="1.076694e-05" iyz="0.000000e+00" izz="2.045865e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.015200" rpy="1.570796 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://testbot_description/meshes/testbot/backward_left_wheel.dae" scale="1 1 1"/>
        </geometry>
        <material name="Rubber_Black"/>
      </visual>
      <!-- MANUAL EDIT (not from fusion2URDF) ==========================
           Was: collision reused backward_left_wheel.dae.
           A 3982-vertex tyre mesh gives ODE a ragged contact patch and
           makes the robot buzz on the spot. Replaced by the exact
           enclosing cylinder: the link's +z IS the joint axis, so the
           cylinder needs no rotation, only a half-width offset.
           ============================================================ -->
      <collision>
        <origin xyz="0 0 ${wheel_collision_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Backward_Right_wheel">
      <inertial>
        <origin xyz="-0.000000 0.000000 0.010783" rpy="0 0 0"/>
        <mass value="0.033729"/>
        <inertia ixx="1.081155e-05" ixy="1.107598e-09" ixz="0.000000e+00"
                 iyy="1.076694e-05" iyz="0.000000e+00" izz="2.045865e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.015200" rpy="1.570796 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://testbot_description/meshes/testbot/Backward_Right_wheel.dae" scale="1 1 1"/>
        </geometry>
        <material name="Rubber_Black"/>
      </visual>
      <!-- MANUAL EDIT (not from fusion2URDF): see left wheel. -->
      <collision>
        <origin xyz="0 0 ${wheel_collision_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- MANUAL EDIT (not from fusion2URDF) ==========================
         NO <dynamics> ON THE WHEEL JOINTS, deliberately.

         Adding what looked like harmless realism -
             <dynamics damping="0.001" friction="0.001"/>
         - cost the wheels 6% of their commanded speed at every setpoint.
         Gazebo Classic implements SDF joint friction with ODE's dParamFMax
         on the joint's motor, which is the SAME parameter
         gazebo_ros2_control uses to drive a velocity command interface.
         The two fight, and joint friction wins, so the velocity motor can
         never reach its target no matter how large <limit effort> is.

         Measured on this robot, 0.15 m/s commanded (4.286 rad/s):
             with <dynamics damping=0.001 friction=0.001>  4.027 rad/s
             with no <dynamics>                            4.286 rad/s
         The error was a flat 6% across the range, which is small enough
         to look like ordinary simulation noise and is not.
         ============================================================== -->

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}Revolute_2" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}backward_left_wheel"/>
      <origin xyz="-0.081000 0.129000 0.015500" rpy="-1.570796 0.000000 0.000000"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <!-- MANUAL EDIT (not from fusion2URDF) ==========================
           Was: <limit effort="100.0" velocity="1.00"/>
           1 rad/s x r=0.035 m is 0.035 m/s, i.e. the robot could not
           reach even a slow walking pace and diff_drive_controller
           saturated immediately. 30 rad/s gives 1.05 m/s top speed.
           100 N.m on a 34 g wheel was meaningless; 1.5 N.m is a
           plausible stall torque for a small geared hobby motor.
           ============================================================ -->
      <limit effort="1.5" velocity="30.0"/>
    </joint>

    <joint name="${prefix}Revolute_4" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Backward_Right_wheel"/>
      <origin xyz="-0.081000 -0.129000 0.015500" rpy="1.570796 0.000000 0.000000"/>
      <!-- MANUAL EDIT (not from fusion2URDF) ==========================
           Was: <axis xyz="0 0 1"/>   THE MIRRORED-WHEEL BUG.

           The exporter gives each continuous joint its own local +z as
           the rotation axis. The left wheel's origin rpy is (-pi/2,0,0),
           so its +z maps to +y in base_link. This wheel's origin rpy is
           (+pi/2,0,0), so its +z maps to -y. The two wheels therefore
           turned OPPOSITE ways for the same command: a forward Twist
           made the robot spin on the spot instead of driving straight.

           Flipping this axis to -z makes it +y in base_link, matching
           the left wheel, so equal positive commands now roll the robot
           forward and /joint_states shows both wheel velocities with
           the same sign.

           PREFERRED FIX (survives a re-export, not applied here):
           set Backward_Right_wheel to rule=world_rpy with
           post_roll_deg=-90 in config/frame_overrides.csv and run
           fusion2URDF tools/reframe.py. That needs debug/frame_model.json
           from a Fusion export with include_debug=true, which this
           package does not ship, so the axis flip is used instead.
           The CSV has been set up so a future reframe does it properly.
           ============================================================ -->
      <axis xyz="0.000000 0.000000 -1.000000"/>
      <!-- MANUAL EDIT (not from fusion2URDF): see left wheel. -->
      <limit effort="1.5" velocity="30.0"/>
    </joint>

    <!-- MANUAL EDIT (not from fusion2URDF) ============================
         The generated <ros2_control> block lived here and hard-coded
         mock_components/GenericSystem, so there was no Gazebo hardware.
         It has moved to urdf/testbot.ros2_control.xacro, where a
         `use_sim` argument switches between GazeboSystem and mock.
         ============================================================== -->

  </xacro:macro>

</robot>
