<?xml version="1.0"?>
<!-- Entry point. Generated by fusion2sim.py.
       xacro urdf/stateqbot.urdf.xacro                -> RViz model
       xacro urdf/stateqbot.urdf.xacro use_sim:=true  -> plus Gazebo parts and sensors -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stateqbot">
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="prefix"  default=""/>
  <!-- set by rsp.launch.py: true when urdf/stateqbot.ros2_control.xacro exists -->
  <xacro:arg name="use_control" default="false"/>
  <xacro:property name="use_sim" value="$(arg use_sim)"/>
  <xacro:property name="prefix"  value="$(arg prefix)"/>
  <material name="Steel">
    <color rgba="0.910 0.678 0.137 1.0" />
  </material>

  <xacro:include filename="$(find stateqbot_description)/urdf/assemblies/stateqbot.urdf.xacro"/>
  <xacro:include filename="$(find stateqbot_description)/urdf/stateqbot.gazebo.xacro"/>
  <xacro:include filename="$(find stateqbot_description)/urdf/stateqbot.sensors.xacro"/>
  <xacro:if value="$(arg use_control)">
    <xacro:include filename="$(find stateqbot_description)/urdf/stateqbot.ros2_control.xacro"/>
  </xacro:if>

  <xacro:stateqbot prefix="${prefix}"/>
  <xacro:if value="$(arg use_control)">
    <xacro:stateqbot_ros2_control prefix="${prefix}" use_sim="${use_sim}"/>
  </xacro:if>
  <xacro:if value="${use_sim}">
    <xacro:stateqbot_gazebo  prefix="${prefix}"/>
    <xacro:stateqbot_sensors prefix="${prefix}"/>
  </xacro:if>
</robot>
