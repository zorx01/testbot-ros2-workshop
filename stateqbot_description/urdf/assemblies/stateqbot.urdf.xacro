<?xml version="1.0"?>
<!-- Generated by fusion2sim.py from the fusion2URDF export.
     wheels: left left_wheel, right Right_wheel
       radius 0.0300 m, width 0.0200 m, separation 0.1240 m
       wheel centres at x = -0.0533, ground at z = -0.0100 in base_link
       Right_wheel: axis flipped so it turns about +y like the other wheel
     caster contact at x = +0.0500, y = +0.0000 (from base_link); frictionless sphere r = 0.005 at wheel-bottom height
     joint Right_wheel -> Right_wheel_joint (same name as a link; Gazebo rejects that)
     joint left_wheel -> left_wheel_joint (same name as a link; Gazebo rejects that)
     joint lidar -> lidar_joint (same name as a link; Gazebo rejects that)
     lidar: link lidar
     total mass 5.975 kg
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stateqbot_macro">
  <xacro:macro name="stateqbot" params="prefix">

    <link name="${prefix}base_link">
    <inertial>
          <origin xyz="0.000124 0.000001 0.020106" rpy="0 0 0" />
          <mass value="5.066079" />
          <inertia ixx="4.880784e-03" ixy="3.230863e-07" ixz="-1.568186e-05" iyy="1.152398e-02" iyz="2.637999e-08" izz="1.503038e-02" />
        </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000" />
        <geometry>
          <mesh filename="package://stateqbot_description/meshes/stateqbot/base_link.dae" scale="1 1 1" />
        </geometry>
        <material name="Steel" />
      </visual>
      <collision>
        <origin xyz="-0.0025 0 0.02" rpy="0 0 0"/>
        <geometry>
          <box size="0.165 0.104 0.05"/>
        </geometry>
      </collision>
      <!-- caster: frictionless, its bottom exactly at wheel-bottom height -->
      <collision>
        <origin xyz="0.05 0 -0.00500066" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Right_wheel">
    <inertial>
          <origin xyz="0.000000 0.000000 0.010000" rpy="0 0 0" />
          <mass value="0.385127" />
          <inertia ixx="8.802519e-05" ixy="0.000000e+00" ixz="0.000000e+00" iyy="8.802519e-05" iyz="0.000000e+00" izz="1.538347e-04" />
        </inertial>
      <visual>
        <origin xyz="0.080000 0.150000 0.000000" rpy="1.570796 0.000000 0.000000" />
        <geometry>
          <mesh filename="package://stateqbot_description/meshes/stateqbot/Right_wheel.dae" scale="1 1 1" />
        </geometry>
        <material name="Steel" />
      </visual>
      <collision>
        <origin xyz="0 3.26796e-09 0.01" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0300007" length="0.02"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}left_wheel">
    <inertial>
          <origin xyz="0.000000 0.000000 0.010000" rpy="0 0 0" />
          <mass value="0.385127" />
          <inertia ixx="8.802519e-05" ixy="0.000000e+00" ixz="0.000000e+00" iyy="8.802519e-05" iyz="0.000000e+00" izz="1.538347e-04" />
        </inertial>
      <visual>
        <origin xyz="0.000000 -0.150000 0.020000" rpy="-1.570796 0.000000 0.000000" />
        <geometry>
          <mesh filename="package://stateqbot_description/meshes/stateqbot/left_wheel.dae" scale="1 1 1" />
        </geometry>
        <material name="Steel" />
      </visual>
      <collision>
        <origin xyz="0 3.26794e-09 0.01" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0300007" length="0.02"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}lidar">
    <inertial>
          <origin xyz="-0.000000 0.000000 0.012500" rpy="0 0 0" />
          <mass value="0.138721" />
          <inertia ixx="1.502810e-05" ixy="0.000000e+00" ixz="0.000000e+00" iyy="1.502810e-05" iyz="0.000000e+00" izz="1.560611e-05" />
        </inertial>
      <visual>
        <origin xyz="-0.040000 0.000000 -0.045000" rpy="0.000000 0.000000 0.000000" />
        <geometry>
          <mesh filename="package://stateqbot_description/meshes/stateqbot/lidar.dae" scale="1 1 1" />
        </geometry>
        <material name="Steel" />
      </visual>
      <collision>
        <origin xyz="0 0 0.0125" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.029984 0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}Right_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Right_wheel"/>
      <origin xyz="-0.053333 -0.052 0.02" rpy="1.5708 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit effort="7.03" velocity="33.3"/>
    </joint>

    <joint name="${prefix}left_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}left_wheel"/>
      <origin xyz="-0.053333 0.052 0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="7.03" velocity="33.3"/>
    </joint>

    <joint name="${prefix}lidar_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}lidar"/>
      <origin xyz="0.04 0 0.045" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1.0" velocity="10.0"/>
    </joint>

  </xacro:macro>
</robot>
