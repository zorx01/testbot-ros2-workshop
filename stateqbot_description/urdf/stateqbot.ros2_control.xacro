<?xml version="1.0"?>
<!-- Controller file. Tells ros2_control which joints it drives. Generated by fusion2sim.py. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="stateqbot_ros2_control" params="prefix use_sim">
    <ros2_control name="${prefix}stateqbot_system" type="system">
      <hardware>
        <xacro:if value="${use_sim}"><plugin>gazebo_ros2_control/GazeboSystem</plugin></xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:unless>
      </hardware>
      <joint name="${prefix}left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-33.3</param><param name="max">33.3</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}Right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-33.3</param><param name="max">33.3</param>
        </command_interface>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}lidar_joint">   <!-- read only, never commanded -->
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
