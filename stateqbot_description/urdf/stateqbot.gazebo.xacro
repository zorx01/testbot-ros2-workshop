<?xml version="1.0"?>
<!-- Gazebo Classic plugin and contact surfaces. Generated by fusion2sim.py. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="stateqbot_gazebo" params="prefix">
    <xacro:if value="$(arg use_control)">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(find stateqbot_description)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>
    </xacro:if>
    <!-- tyres grip -->
    <gazebo reference="${prefix}left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1.195e+06</kp><kd>119.5</kd><minDepth>0.001</minDepth><material>Gazebo/DarkGrey</material></gazebo>
    <gazebo reference="${prefix}Right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1.195e+06</kp><kd>119.5</kd><minDepth>0.001</minDepth><material>Gazebo/DarkGrey</material></gazebo>
    <!-- the base carries the caster sphere(s): they slide -->
    <gazebo reference="${prefix}base_link"><mu1>0.0</mu1><mu2>0.0</mu2><kp>1.195e+06</kp><kd>119.5</kd><minDepth>0.001</minDepth></gazebo>
  </xacro:macro>
</robot>
